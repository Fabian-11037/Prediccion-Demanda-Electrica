  "formulas": [
    {
      "file": "m4_n_formula_01.svg",
      "latex": "\n\\delta_{E,t,h}=\\rho\\,\\mathrm{sigmoid}(g_E(u_{E,t})_h)\\,\\tanh(v_E(u_{E,t})_h),\\qquad\\rho=0.02.\n"
    },
    {
      "file": "m4_n_formula_02.svg",
      "latex": "\np^{(E)}_{t,h}=\\ell_t\\left(o_{E,0,t,h}+\\eta_t\\delta_{E,t,h}\\right).\n"
    },
    {
      "file": "m4_n_formula_03.svg",
      "latex": "\nZ_0=\\mathrm{Conv}_{1\\times1}(U),\\qquad U\\in\\mathbb{R}^{56\\times7\\times24},\\quad Z_0\\in\\mathbb{R}^{32\\times7\\times24}.\n"
    },
    {
      "file": "m4_n_formula_04.svg",
      "latex": "\nZ_{b+1}=\\mathrm{GroupNorm}\\left(Z_b+\\mathrm{Conv}_{1\\times5}\\left(D_{0.1}\\left(\\mathrm{GELU}(\\mathrm{Conv}_{3\\times3}(Z_b))\\right)\\right)\\right).\n"
    },
    {
      "file": "m4_n_formula_05.svg",
      "latex": "\np^{(P)}_{t,h}=\\ell_t\\left(1+\\mathrm{MLP}\\left([Z_{B,\\mathrm{ultimo},h};\\overline{Z}_{B,h};c_{t,h}]\\right)\\right).\n"
    },
    {
      "file": "m4_n_formula_06.svg",
      "latex": "\nb_{t,h}=\\sum_{j=1}^{3}w_{t,h,j}\\,p^{(j)}_{t,h},\\qquad w_{t,h,j}\\geq0,\\quad\\sum_{j=1}^{3}w_{t,h,j}=1.\n"
    },
    {
      "file": "m4_n_formula_07.svg",
      "latex": "\nr_{i,h}=\\frac{y_{i,h}-b_{i,h}}{q},\\qquad h=1,\\ldots,24.\n"
    },
    {
      "file": "m4_n_formula_08.svg",
      "latex": "\nz_{t,j}=\\frac{u_{t,j}-\\mu_j}{s_j}.\n"
    },
    {
      "file": "m4_n_formula_09.svg",
      "latex": "\na_t=\\mathrm{LN}(W_Qz_t+c_Q),\\qquad k_i=\\mathrm{LN}(W_Kz_i+c_K).\n"
    },
    {
      "file": "m4_n_formula_10.svg",
      "latex": "\ns_{t,i}=\\frac{a_t^\\mathsf{T}k_i}{\\sqrt{32}}.\n"
    },
    {
      "file": "m4_n_formula_11.svg",
      "latex": "\n2\\leq t-i\\leq365\\ \\mathrm{dias}.\n"
    },
    {
      "file": "m4_n_formula_12.svg",
      "latex": "\n\\alpha_{t,i}=\\frac{\\exp(s_{t,i})}{\\sum_{j\\in A_t}\\exp(s_{t,j})},\\qquad i\\in A_t.\n"
    },
    {
      "file": "m4_n_formula_13.svg",
      "latex": "\nm_{t,h}=\\sum_{i\\in A_t}\\alpha_{t,i}r_{i,h}.\n"
    },
    {
      "file": "m4_n_formula_14.svg",
      "latex": "\nd_t=\\sqrt{\\max\\left(10^{-12},\\frac{1}{24}\\sum_{h=1}^{24}\\sum_{i\\in A_t}\\alpha_{t,i}(r_{i,h}-m_{t,h})^2\\right)}.\n"
    },
    {
      "file": "m4_n_formula_15.svg",
      "latex": "\nv_t=\\mathrm{GELU}(W_1c_t+b_1),\\qquad g_t=\\mathrm{sigmoid}(W_2D_{0.1}(v_t)+b_2).\n"
    },
    {
      "file": "m4_n_formula_16.svg",
      "latex": "\n\\widehat y_{t,h}=b_{t,h}+q\\,g_t\\,m_{t,h}.\n"
    },
    {
      "file": "m4_n_formula_17.svg",
      "latex": "\n\\mathcal{L}=\\frac{1}{24|B|}\\sum_{t\\in B}\\sum_{h=1}^{24}\\frac{|y_{t,h}-\\widehat y_{t,h}|}{q}.\n"
    },
    {
      "file": "m4_n_formula_18.svg",
      "latex": "\nP_{\\mathrm{activo}}=2(32n+32+64)+(36\\cdot64+64+64+1)=64n+2625.\n"
    },
    {
      "file": "m4_n_formula_19.svg",
      "latex": "\n\\frac{\\partial\\mathcal{L}}{\\partial g}=q\\sum_hv_h\\bar{r}_h,\\qquad\n\\frac{\\partial\\bar{r}_h}{\\partial s_i}=\\alpha_i(r_{i,h}-\\bar{r}_h).\n"
    },
    {
      "file": "m4_n_formula_20.svg",
      "latex": "\n\\frac{\\partial\\mathcal{L}}{\\partial s_i}\n=q\\sum_hv_h\\left[g\\alpha_i(r_{i,h}-\\bar{r}_h)+\\bar{r}_h\\frac{\\partial g}{\\partial s_i}\\right].\n"
    },
    {
      "file": "m4_n_formula_21.svg",
      "latex": "\nB_t=\\{i:2\\leq t-i\\leq365,\\ \\tau_i<t\\},\\qquad A_t\\subseteq B_t.\n"
    },
    {
      "file": "m4_n_formula_22.svg",
      "latex": "\n\\widehat{\\mathbf{y}}_t=\\mathbf{b}_t+qg_t\\sum_{i\\in A_t}\\alpha_{t,i}\\mathbf{r}_i.\n"
    },
    {
      "file": "m4_n_formula_23.svg",
      "latex": "\nL_{t,h}\\leq\\bar r_{t,h}=\\sum_i\\alpha_{t,i}r_{i,h}\\leq U_{t,h}.\n"
    },
    {
      "file": "m4_n_formula_24.svg",
      "latex": "\nb_{t,h}+qg_tL_{t,h}\\leq\\widehat y_{t,h}\\leq b_{t,h}+qg_tU_{t,h},\\qquad\n|\\widehat y_{t,h}-b_{t,h}|\\leq qg_t\\max_i|r_{i,h}|.\n"
    },
    {
      "file": "m4_n_formula_25.svg",
      "latex": "\n\\|\\widehat{\\mathbf{y}}'-\\widehat{\\mathbf{y}}\\|_\\infty\n\\leq\\|\\Delta\\mathbf{b}\\|_\\infty\n+q\\left(M|g'-g|+g'M\\|\\boldsymbol{\\alpha}'-\\boldsymbol{\\alpha}\\|_1+g'D_R\\right).\n"
    },
    {
      "file": "m4_n_formula_26.svg",
      "latex": "\ng'\\sum_i\\alpha'_i\\mathbf{r}'_i-g\\sum_i\\alpha_i\\mathbf{r}_i\n=(g'-g)\\sum_i\\alpha_i\\mathbf{r}_i\n+g'\\sum_i(\\alpha'_i-\\alpha_i)\\mathbf{r}_i\n+g'\\sum_i\\alpha'_i(\\mathbf{r}'_i-\\mathbf{r}_i).\n"
    },
    {
      "file": "m4_n_formula_27.svg",
      "latex": "\ns_{(k)}-s_{(k+1)}>2\\varepsilon_s\n\\quad\\Longrightarrow\\quad A'_t=A_t.\n"
    },
    {
      "file": "m4_n_formula_28.svg",
      "latex": "\nL_{\\mathrm{LN}\\circ W}\\leq\\frac{\\|W\\|_2\\|\\gamma\\|_\\infty}{\\sqrt{\\epsilon}}.\n"
    },
    {
      "file": "m4_n_formula_29.svg",
      "latex": "\n|e_h-c_h|\\leq|e_h|\n\\quad\\Longleftrightarrow\\quad\n0\\leq\\frac{c_h}{e_h}\\leq2.\n"
    },
    {
      "file": "m4_n_formula_30.svg",
      "latex": "\n\\operatorname{MAE}_{\\mathrm{M4}}\\leq\\operatorname{MAE}_{\\mathrm{M1}},\\qquad\n\\operatorname{MASE}_{\\mathrm{M4}}\\leq\\operatorname{MASE}_{\\mathrm{M1}}.\n"
    }
  ],
