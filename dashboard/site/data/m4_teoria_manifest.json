  "formulas": [
    {
      "file": "m4_n_formula_01.svg",
      "latex": "\\delta_{E,t,h}=\\rho\\,\\mathrm{sigmoid}(g_E(u_{E,t})_h)\\,\\tanh(v_E(u_{E,t})_h),\\qquad\\rho=0.02."
    },
    {
      "file": "m4_n_formula_02.svg",
      "latex": "p^{(E)}_{t,h}=\\ell_t\\left(o_{E,0,t,h}+\\eta_t\\delta_{E,t,h}\\right)."
    },
    {
      "file": "m4_n_formula_03.svg",
      "latex": "Z_0=\\mathrm{Conv}_{1\\times1}(U),\\qquad U\\in\\mathbb{R}^{56\\times7\\times24},\\quad Z_0\\in\\mathbb{R}^{32\\times7\\times24}."
    },
    {
      "file": "m4_n_formula_04.svg",
      "latex": "Z_{b+1}=\\mathrm{GroupNorm}\\left(Z_b+\\mathrm{Conv}_{1\\times5}\\left(D_{0.1}\\left(\\mathrm{GELU}(\\mathrm{Conv}_{3\\times3}(Z_b))\\right)\\right)\\right)."
    },
    {
      "file": "m4_n_formula_05.svg",
      "latex": "p^{(P)}_{t,h}=\\ell_t\\left(1+\\mathrm{MLP}\\left([Z_{B,\\mathrm{ultimo},h};\\overline{Z}_{B,h};c_{t,h}]\\right)\\right)."
    },
    {
      "file": "m4_n_formula_06.svg",
      "latex": "b_{t,h}=\\sum_{j=1}^{3}w_{t,h,j}\\,p^{(j)}_{t,h},\\qquad w_{t,h,j}\\geq0,\\quad\\sum_{j=1}^{3}w_{t,h,j}=1."
    },
    {
      "file": "m4_n_formula_07.svg",
      "latex": "r_{i,h}=\\frac{y_{i,h}-b_{i,h}}{q},\\qquad h=1,\\ldots,24."
    },
    {
      "file": "m4_n_formula_08.svg",
      "latex": "z_{t,j}=\\frac{u_{t,j}-\\mu_j}{s_j}."
    },
    {
      "file": "m4_n_formula_09.svg",
      "latex": "a_t=\\mathrm{LN}(W_Qz_t+c_Q),\\qquad k_i=\\mathrm{LN}(W_Kz_i+c_K)."
    },
    {
      "file": "m4_n_formula_10.svg",
      "latex": "s_{t,i}=\\frac{a_t^\\mathsf{T}k_i}{\\sqrt{32}}."
    },
    {
      "file": "m4_n_formula_11.svg",
      "latex": "2\\leq t-i\\leq365\\ \\mathrm{dias}."
    },
    {
      "file": "m4_n_formula_12.svg",
      "latex": "\\alpha_{t,i}=\\frac{\\exp(s_{t,i})}{\\sum_{j\\in A_t}\\exp(s_{t,j})},\\qquad i\\in A_t."
    },
    {
      "file": "m4_n_formula_13.svg",
      "latex": "m_{t,h}=\\sum_{i\\in A_t}\\alpha_{t,i}r_{i,h}."
    },
    {
      "file": "m4_n_formula_14.svg",
      "latex": "d_t=\\sqrt{\\max\\left(10^{-12},\\frac{1}{24}\\sum_{h=1}^{24}\\sum_{i\\in A_t}\\alpha_{t,i}(r_{i,h}-m_{t,h})^2\\right)}."
    },
    {
      "file": "m4_n_formula_15.svg",
      "latex": "v_t=\\mathrm{GELU}(W_1c_t+b_1),\\qquad g_t=\\mathrm{sigmoid}(W_2D_{0.1}(v_t)+b_2)."
    },
    {
      "file": "m4_n_formula_16.svg",
      "latex": "\\widehat y_{t,h}=b_{t,h}+q\\,g_t\\,m_{t,h}."
    },
    {
      "file": "m4_n_formula_17.svg",
      "latex": "\\mathcal{L}=\\frac{1}{24|B|}\\sum_{t\\in B}\\sum_{h=1}^{24}\\frac{|y_{t,h}-\\widehat y_{t,h}|}{q}."
    },
    {
      "file": "m4_n_formula_18.svg",
      "latex": "P_{\\mathrm{activo}}=2(32n+32+64)+(36\\cdot64+64+64+1)=64n+2625."
    },
    {
      "file": "m4_n_formula_19.svg",
      "latex": "\\|\\Delta(x)-\\Delta(x')\\|_\\infty\\leq qR\\left(|g(x)-g(x')|+\\|\\alpha(x)-\\alpha(x')\\|_1\\right)."
    },
    {
      "file": "m4_n_formula_20.svg",
      "latex": "\\Delta(x)-\\Delta(x')=q\\,(g(x)-g(x'))\\sum_i\\alpha_i(x)r_i+q\\,g(x')\\sum_i(\\alpha_i(x)-\\alpha_i(x'))r_i."
    },
    {
      "file": "m4_n_formula_21.svg",
      "latex": "\\frac{\\partial\\mathcal{L}}{\\partial g}=q\\sum_hv_h\\bar{r}_h,\\qquad\n\\frac{\\partial\\bar{r}_h}{\\partial s_i}=\\alpha_i(r_{i,h}-\\bar{r}_h)."
    },
    {
      "file": "m4_n_formula_22.svg",
      "latex": "\\frac{\\partial\\mathcal{L}}{\\partial s_i}\n=q\\sum_hv_h\\left[g\\alpha_i(r_{i,h}-\\bar{r}_h)+\\bar{r}_h\\frac{\\partial g}{\\partial s_i}\\right]."
    },
    {
      "file": "m4_n_formula_23.svg",
      "latex": "|\\widehat{y}_h-b_h|\\leq qg\\sum_i\\alpha_i|r_{i,h}|\\leq qg\\max_i|r_{i,h}|."
    }
  ],
